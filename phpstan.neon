services:
    -
        class: \Tools\PHPStan\RegistryPropertyReflectionExtension
        tags:
            - phpstan.broker.propertiesClassReflectionExtension
parameters:
    level: 1
    paths:
        - upload/admin/controller/common
        - upload/catalog/controller/common
    excludePaths:
        - upload/system/storage/vendor
        - upload/system/storage/cache
        - upload/system/helper/HTMLPurifier
        - upload/catalog/controller/extension/module/laybuy_layout.php
    tmpDir: .cache
    ignoreErrors:
        - '#Class Event constructor invoked with 1 parameter, 4-5 required\.#'
        - '#Constant [A-Z_]+ not found\.#'
        - '#might not be defined\.#'
        - '#invoked with \d+ parameters?, \d+ required\.#'
        - '#Creation of dynamic property#'
    reportUnmatchedIgnoredErrors: false