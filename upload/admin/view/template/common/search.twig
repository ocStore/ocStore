<div id="search" class="dropdown">
  <div class="input-group">
    <button type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" class="btn btn-secondary dropdown-toggle" title="{{ text_search_options }}"><i id="search-icon" class="fa-solid fa-magnifying-glass"></i> <i class="fa-solid fa-caret-down"></i></button>
    <ul class="dropdown-menu">
      <li><h6 class="dropdown-header">{{ text_search_options }}</h6></li>
      {% for option in options %}
        <li><a href="#" class="dropdown-item" data-oc-option="{{ option.code }}" data-oc-icon="{{ option.icon }}" data-oc-placeholder="{{ option.placeholder }}"><i class="{{ option.icon }} fa-fw"></i> {{ option.text }}</a></li>
      {% endfor %}
    </ul>
    <input type="text" name="filter_name" value="" placeholder="{{ options.0.placeholder }}" id="input-search" autocomplete="off" class="form-control"/>
    <input type="hidden" name="filter_option" value="{{ options.0.code }}" id="input-search-option"/>
  </div>
  <div id="search-result" class="dropdown-menu"></div>
</div>
<script type="text/javascript"><!--
$('#search .dropdown-menu [data-oc-option]').on('click', function (e) {
    e.preventDefault();

    $('#input-search-option').val($(this).attr('data-oc-option'));
    $('#input-search').attr('placeholder', $(this).attr('data-oc-placeholder')).trigger('focus');

    $('#search-result').removeClass('show').html('');
});

$('#input-search').on('input', function () {
    var element = this;

    if (element.timer) {
        clearTimeout(element.timer);
    }

    if (this.value.length < ($('#input-search-option').val() == 'order' ? 1 : 3)) {
        $('#search-result').removeClass('show').html('');

        return;
    }

    element.timer = setTimeout(function () {
        $.ajax({
            url: '{{ search }}&filter_option=' + encodeURIComponent($('#input-search-option').val()) + '&filter_name=' + encodeURIComponent(element.value),
            dataType: 'json',
            beforeSend: function () {
                $('#search-icon').addClass('fa-beat-fade');
            },
            complete: function () {
                $('#search-icon').removeClass('fa-beat-fade');
            },
            success: function (json) {
                if (json['results']) {
                    $('#search-result').html(json['results']).addClass('show');
                } else {
                    $('#search-result').removeClass('show').html('');
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }, 300);
});

$(document).on('click', function (e) {
    if (!$(e.target).closest('#search').length) {
        $('#search-result').removeClass('show');
    }
});
//--></script>
