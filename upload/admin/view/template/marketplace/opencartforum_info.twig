{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				<a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div id="marketplace-extension-info" class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}</div>
		{% endif %}
		<div class="card">
		<div class="card-body">
		<div class="extension-head mb-3">
			<h2 class="extension-head-title">{{ name }}{% if ukraine %} <span class="extension-flag" title="Ukraine"></span>{% endif %}</h2>
			<div class="extension-head-meta">
				<a href="{{ filter_member }}" class="extension-member">
					<img src="{{ member_image }}" alt="{{ member_username }}" class="rounded-circle"/> {{ member_username }}
				</a>
				{% if rating_total %}
					<span class="extension-stars">{% for i in 1..5 %}{% if rating < i %}<i class="fa-regular fa-star"></i>{% else %}<i class="fa-solid fa-star"></i>{% endif %}{% endfor %}</span>
					<span>{{ rating_total }} {{ text_reviews }}</span>
				{% endif %}
				<span><i class="fa-solid fa-download"></i> {{ downloaded }}</span>
				<span><i class="fa-solid fa-cart-shopping"></i> {{ sales }}</span>
				<span><i class="fa-solid fa-clock-rotate-left"></i> {{ date_modified }}</span>
			</div>
		</div>
		<div class="row extension-info">
			<div class="col-lg-8">
				{% if banner %}
					<div class="extension-banner text-center mb-3">
						<img src="{{ banner }}" title="{{ name }}" alt="{{ name }}" class="img-fluid"/>
					</div>
				{% endif %}
				{% if images %}
					<div class="thumbnails extension-strip mb-3">
						{% for image in images %}
							<a href="{{ image.popup }}"><img src="{{ image.thumb }}" alt="{{ name }}" title="{{ name }}"/></a>
						{% endfor %}
					</div>
				{% endif %}
				<div>
					<ul class="nav nav-tabs">
							<li class="nav-item"><a href="#tab-description" class="nav-link active" data-bs-toggle="tab">{{ tab_description }}</a></li>
							{% if changelog %}
								<li class="nav-item"><a href="#tab-changelog" class="nav-link" data-bs-toggle="tab">{{ tab_changelog }}</a></li>
							{% endif %}
							{% if documentation %}
								<li class="nav-item"><a href="#tab-documentation" class="nav-link" data-bs-toggle="tab">{{ tab_documentation }}</a></li>
							{% endif %}
					</ul>
					<div class="tab-content extension-text pt-3">
						<div id="tab-description" class="tab-pane fade show active">{{ description }}</div>
						{% if changelog %}
							<div id="tab-changelog" class="tab-pane fade">{{ changelog }}</div>
						{% endif %}
						{% if documentation %}
							<div id="tab-documentation" class="tab-pane fade">{{ documentation }}</div>
						{% endif %}
					</div>
				</div>
			</div>
			<div class="col-lg-4">
				<div class="extension-side">
				<div class="mb-4">
					<div>
						<div class="extension-buy-price">
							{% if license %}
								{% if old_price %}<s>{{ old_price }}</s>{% endif %}
								<strong>{{ price }}</strong>
								{% if discount %}<span class="extension-discount-inline">-{{ discount }}%</span>{% endif %}
							{% else %}
								<strong class="text-success">{{ text_free }}</strong>
							{% endif %}
						</div>
						<a href="{{ extension_url }}" target="_blank" id="button-buy" class="btn btn-primary w-100 mb-2"><i class="fa-solid fa-cart-shopping"></i> {{ button_purchase }}</a>
						<a href="https://opencartforum.com/topic/{{ topicid }}-{{ topicseoname }}" target="_blank" class="btn btn-outline-secondary w-100"><i class="fa-regular fa-comments"></i> {{ button_support }}</a>
					</div>
					<table class="table table-sm extension-fields mt-3 mb-0">
						{% for field in cfields %}
							<tr>
								<td>{{ field.name }}</td>
								<td class="text-end">{{ field.value|raw }}</td>
							</tr>
						{% endfor %}
						<tr>
							<td>{{ text_download }}</td>
							<td class="text-end">{{ downloaded }}</td>
						</tr>
						<tr>
							<td>{{ text_date_added }}</td>
							<td class="text-end">{{ date_added }}</td>
						</tr>
						<tr>
							<td>{{ text_date_modified }}</td>
							<td class="text-end">{{ date_modified }}</td>
						</tr>
					</table>
				</div>
				<div class="border-top pt-4">
					<div class="text-center">
						<img src="{{ member_image }}" alt="{{ member_username }}" title="{{ member_username }}" class="rounded-circle developer-avatar"/>
						<h5 class="mt-2 mb-0"><a href="{{ filter_member }}">{{ member_username }}</a></h5>
						{% if member_date_added %}
							<small class="text-muted d-block">{{ text_member_since }} {{ member_date_added }}</small>
						{% endif %}
						<a href="{{ filter_member }}" class="btn btn-light w-100 mt-3">{{ button_view_all }}</a>
					</div>
				</div>
				</div>
			</div>
		</div>
		</div>
		</div>
	</div>
</div>
<script type="text/javascript"><!--
$(document).ready(function () {
    $('.thumbnails').magnificPopup({
        type: 'image',
        delegate: 'a',
        gallery: {
            enabled: true
        }
    });
});
//--></script>
{{ footer }}
