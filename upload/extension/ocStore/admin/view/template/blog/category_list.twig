{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" form="form-category" onclick="window.location.href = '{{ add }}';" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fas fa-plus"></i></button> 
        <button type="submit" form="form-category" formaction="{{ repair }}" data-bs-toggle="tooltip" title="{{ button_rebuild }}" class="btn btn-light"><i class="fas fa-sync"></i></button>
        <button type="submit" form="form-category" formaction="{{ enabled }}" data-bs-toggle="tooltip" title="{{ button_enable }}" class="btn btn-light"><i class="fas fa-play"></i></button>
        <button type="submit" form="form-category" formaction="{{ disabled }}" data-bs-toggle="tooltip" title="{{ button_disable }}" class="btn btn-light"><i class="fas fa-pause"></i></button>
        <button type="button" form="form-category" onclick="confirm('{{ text_confirm }}') ? $('#form-category').submit() : false;" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"><i class="fas fa-trash-alt"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fas fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fas fa-check-circle"></i> {{ success }}
      <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fas fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="card-body">
        <form action="{{ delete }}" not-action="{{ action }}|list" method="post" enctype="multipart/form-data" id="form-category" data-oc-toggle="not-ajax">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-start">{{ column_name }}</td>
                  <td class="text-end">{{ column_sort_order }}</td>
                  <td class="text-end">{{ column_noindex }}</td>
                  <td class="text-end">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if categories %}
                {% for category in categories %}
                <tr>
                  <td class="text-center">{% if category.blog_category_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ category.blog_category_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ category.blog_category_id }}" />
                    {% endif %}
                  </td>
                  {% if category.href %}
                  <td class="left">{{ category.indent }}<a href="{{ category.href }}">{{ category.name }}</a>&nbsp;<i class="fas fa-sort-desc"></i></td>
                  {% else %}
                  <td class="left">{{ category.indent }}{{ category.name }}</td>
                  {% endif %}
                  <td class="text-end">{{ category.sort_order }}</td>
                  <td class="text-end">{{ category.noindex }}</td>
                  <td class="text-end">
                    <a href="{{ category.href_shop }}" data-bs-toggle="tooltip" title="{{ button_shop }}" class="btn btn-success" rel="noreferrer noopener" target="_blank"><i class="fas fa-eye"></i></a>
                    <a href="{{ category.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fas fa-pencil-alt"></i></a>
                  </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="5">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row">
          <div class="col-sm-12 text-end">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
// IE and Edge fix!
$('button[form=\'form-category\']').on('click', function(e) {
	$('#form-category').attr('action', $(this).attr('formaction'));
});
 //--></script>
{{ footer }}