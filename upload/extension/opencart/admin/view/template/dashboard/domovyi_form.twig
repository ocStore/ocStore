{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-dashboard" class="btn btn-primary"><i class="fa-solid fa-save"></i> {{ button_save }}</button>
        <a href="{{ dashboard }}" class="btn btn-light"><i class="fa-solid fa-gauge-high"></i> {{ text_dashboard }}</a>
        <a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-puzzle-piece"></i> {{ text_extension }}</a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-dashboard" action="{{ save }}" method="post" data-oc-toggle="ajax">
          {{ fields }}
        </form>
      </div>
      <div class="card-footer text-center"><strong><a href="https://opencartforum.com/files/file/8732-domoviy-vidzhet-dlya-monitoringu-stanu-magazinu" target="_blank" rel="noopener" class="text-reset">{{ text_copyright }}</a></strong></div>
    </div>
  </div>
</div>
