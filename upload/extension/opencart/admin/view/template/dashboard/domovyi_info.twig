<div id="domovyi-launcher">
  <button type="button" id="button-domovyi-open" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ text_open }}" class="btn btn-dark shadow">
<svg viewBox="0 0 64 64" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg" class="align-text-bottom me-1" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="domovyi-glow-launcher" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6ee787"/>
      <stop offset="1" stop-color="#1f9d55"/>
    </linearGradient>
  </defs>
  <path d="M32 2 5 20v4h54v-4z" fill="currentColor" opacity=".8"/>
  <rect x="9" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="50" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="15" y="22" width="34" height="25" rx="9" fill="currentColor"/>
  <rect x="23" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-launcher)"/>
  <rect x="35" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-launcher)"/>
  <path d="M27 41.5c1.5 1.7 3.1 2.5 5 2.5s3.5-.8 5-2.5" stroke="url(#domovyi-glow-launcher)" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M32 46.5l9.5 2.6v4.4c0 4.2-3.8 7.4-9.5 10-5.7-2.6-9.5-5.8-9.5-10v-4.4z" fill="url(#domovyi-glow-launcher)"/>
  <path d="M28.4 53.6l2.7 2.7 4.7-4.9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
    {{ heading_title }}
    {% if issues.total %}
      <span class="badge text-bg-danger ms-1">{{ issues.total }}</span>
    {% else %}
      <span class="badge text-bg-success ms-1"><i class="fa-solid fa-check"></i></span>
    {% endif %}
  </button>
</div>
<div id="offcanvas-domovyi" class="offcanvas offcanvas-end" style="width: 780px; max-width: 100%;" tabindex="-1">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title text-truncate d-flex align-items-center gap-2"><svg viewBox="0 0 64 64" width="26" height="26" fill="none" xmlns="http://www.w3.org/2000/svg" class="" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="domovyi-glow-panel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6ee787"/>
      <stop offset="1" stop-color="#1f9d55"/>
    </linearGradient>
  </defs>
  <path d="M32 2 5 20v4h54v-4z" fill="currentColor" opacity=".8"/>
  <rect x="9" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="50" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="15" y="22" width="34" height="25" rx="9" fill="currentColor"/>
  <rect x="23" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-panel)"/>
  <rect x="35" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-panel)"/>
  <path d="M27 41.5c1.5 1.7 3.1 2.5 5 2.5s3.5-.8 5-2.5" stroke="url(#domovyi-glow-panel)" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M32 46.5l9.5 2.6v4.4c0 4.2-3.8 7.4-9.5 10-5.7-2.6-9.5-5.8-9.5-10v-4.4z" fill="url(#domovyi-glow-panel)"/>
  <path d="M28.4 53.6l2.7 2.7 4.7-4.9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg> {{ heading_title }}</h5>
    <div class="ms-auto d-flex align-items-center gap-2">
      <button type="button" id="button-about" data-bs-toggle="tooltip" title="{{ text_about }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-circle-info"></i></button>
      <a href="{{ setting }}" data-bs-toggle="tooltip" title="{{ text_setting }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-cog"></i></a>
      <button type="button" class="btn-close ms-1" data-bs-dismiss="offcanvas"></button>
    </div>
  </div>
  <div class="offcanvas-body" id="offcanvas-domovyi-body">
    <div class="text-center text-muted py-5"><i class="fa-solid fa-circle-notch fa-spin fa-2x"></i></div>
  </div>
</div>
<div id="modal-domovyi-about" class="modal fade">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2"><svg viewBox="0 0 64 64" width="26" height="26" fill="none" xmlns="http://www.w3.org/2000/svg" class="" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="domovyi-glow-modal-title" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6ee787"/>
      <stop offset="1" stop-color="#1f9d55"/>
    </linearGradient>
  </defs>
  <path d="M32 2 5 20v4h54v-4z" fill="currentColor" opacity=".8"/>
  <rect x="9" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="50" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="15" y="22" width="34" height="25" rx="9" fill="currentColor"/>
  <rect x="23" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-modal-title)"/>
  <rect x="35" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-modal-title)"/>
  <path d="M27 41.5c1.5 1.7 3.1 2.5 5 2.5s3.5-.8 5-2.5" stroke="url(#domovyi-glow-modal-title)" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M32 46.5l9.5 2.6v4.4c0 4.2-3.8 7.4-9.5 10-5.7-2.6-9.5-5.8-9.5-10v-4.4z" fill="url(#domovyi-glow-modal-title)"/>
  <path d="M28.4 53.6l2.7 2.7 4.7-4.9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg> {{ heading_title }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-center text-body mb-3"><svg viewBox="0 0 64 64" width="120" height="120" fill="none" xmlns="http://www.w3.org/2000/svg" class="" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="domovyi-glow-modal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6ee787"/>
      <stop offset="1" stop-color="#1f9d55"/>
    </linearGradient>
  </defs>
  <path d="M32 2 5 20v4h54v-4z" fill="currentColor" opacity=".8"/>
  <rect x="9" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="50" y="29" width="5" height="10" rx="2.5" fill="currentColor" opacity=".65"/>
  <rect x="15" y="22" width="34" height="25" rx="9" fill="currentColor"/>
  <rect x="23" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-modal)"/>
  <rect x="35" y="29" width="6" height="9" rx="3" fill="url(#domovyi-glow-modal)"/>
  <path d="M27 41.5c1.5 1.7 3.1 2.5 5 2.5s3.5-.8 5-2.5" stroke="url(#domovyi-glow-modal)" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M32 46.5l9.5 2.6v4.4c0 4.2-3.8 7.4-9.5 10-5.7-2.6-9.5-5.8-9.5-10v-4.4z" fill="url(#domovyi-glow-modal)"/>
  <path d="M28.4 53.6l2.7 2.7 4.7-4.9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div>
        <p>{{ text_about_intro }}</p>
        <p class="fw-semibold">{{ text_about_community }}</p>
        <blockquote class="border-start border-3 ps-3 text-body-secondary fst-italic">{{ text_about_inspire }}</blockquote>
        <div class="d-grid gap-2">
          <a href="https://opencartforum.com/profile/3769-dinox/" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fa-solid fa-user"></i> {{ text_about_author }}</a>
          <a href="https://opencartforum.com/files/file/8732-domoviy-vidzhet-dlya-monitoringu-stanu-magazinu" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{ text_about_updates }}</a>
          <a href="https://opencartforum.com/files/developer/3769-dinox/" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fa-solid fa-puzzle-piece"></i> {{ text_about_files }}</a>
        </div>
      </div>
      <div class="modal-footer justify-content-center"><small class="text-muted">{{ text_copyright }}</small></div>
    </div>
  </div>
</div>
<style>
#domovyi-launcher {
	position: fixed;
	right: 24px;
	bottom: 0;
	z-index: 1030;
}

#domovyi-launcher .btn {
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
	padding: 0.5rem 1rem;
}
</style>
<script type="text/javascript"><!--
$('#domovyi-launcher, #offcanvas-domovyi, #modal-domovyi-about').appendTo('body');

$('#button-about').on('click', function() {
    new bootstrap.Modal('#modal-domovyi-about').show();
});

$('#offcanvas-domovyi').on('show.bs.offcanvas', function() {
    if (!$(this).attr('data-oc-loaded')) {
        $(this).attr('data-oc-loaded', 1);

        $('#offcanvas-domovyi-body').load('index.php?route=extension/opencart/dashboard/domovyi.panel&user_token={{ user_token }}');
    }
});

$('#button-domovyi-open').on('click', function() {
    bootstrap.Offcanvas.getOrCreateInstance('#offcanvas-domovyi').show();
});
//--></script>
