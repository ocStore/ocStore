<div id="domovyi" class="card mb-3">
  <div class="card-header">
    <div class="float-end">
      <button type="button" id="button-phpinfo" data-bs-toggle="tooltip" title="{{ text_phpinfo }}" class="btn btn-outline-secondary btn-sm">phpinfo</button>
      <a href="{{ setting }}" data-bs-toggle="tooltip" title="{{ text_setting }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-cog"></i></a>
    </div>
    <i class="fa-solid fa-house-chimney-crack"></i> {{ heading_title }}
  </div>
  <div class="card-body">
    <div id="domovyi-alert"></div>
    <div class="row row-cols-2 row-cols-md-4 g-2 mb-4">
      <div class="col">
        <div class="border rounded p-2 h-100 domovyi-copy" data-oc-copy="#domovyi-php" role="button" data-bs-toggle="tooltip" title="{{ text_copy }}">
          <div class="text-muted small text-uppercase">{{ text_php }}</div>
          <div class="fw-semibold text-truncate" id="domovyi-php">{{ phpversion }}</div>
        </div>
      </div>
      <div class="col">
        <div class="border rounded p-2 h-100 domovyi-copy" data-oc-copy="#domovyi-dbms" role="button" data-bs-toggle="tooltip" title="{{ text_copy }}">
          <div class="text-muted small text-uppercase">{{ text_dbms }}</div>
          <div class="fw-semibold text-truncate" id="domovyi-dbms">{{ database_version }}</div>
        </div>
      </div>
      {% if disk_free_space %}
        <div class="col">
          <div class="border rounded p-2 h-100{% if disk_free_space_warning %} border-danger text-danger{% endif %}">
            <div class="text-muted small text-uppercase">{{ text_disk }}</div>
            <div class="fw-semibold text-truncate">{{ disk_free_space.size }} {{ disk_free_space.unit }}</div>
          </div>
        </div>
      {% endif %}
      {% if ioncube_version %}
        <div class="col">
          <div class="border rounded p-2 h-100">
            <div class="text-muted small text-uppercase">{{ text_ioncube }}</div>
            <div class="fw-semibold text-truncate">{{ ioncube_version }}</div>
          </div>
        </div>
      {% endif %}
      <div class="col">
        <div class="border rounded p-2 h-100">
          <div class="text-muted small text-uppercase">{{ text_database }}</div>
          <div class="fw-semibold text-truncate">{{ database.total }}</div>
        </div>
      </div>
    </div>
    {% if disk_free_space_warning %}
      <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> {{ disk_free_space_warning }}</div>
    {% endif %}
    <div class="row g-4">
      <div class="col-lg-6">
        <h6 class="text-uppercase text-muted small">{{ text_cache_control }}</h6>
        <div class="row row-cols-2 g-2 mb-4">
          <div class="col"><button type="button" value="theme" data-bs-toggle="tooltip" title="{{ entry_theme_cache }}" class="btn btn-outline-warning w-100 text-truncate button-developer"><i class="fa-solid fa-rotate"></i> {{ text_cache_theme }}</button></div>
          <div class="col"><button type="button" id="button-ocmod" data-bs-toggle="tooltip" title="{{ entry_modification_cache }}" class="btn btn-outline-warning w-100 text-truncate"><i class="fa-solid fa-rotate"></i> {{ text_cache_ocmod }}</button></div>
          <div class="col"><button type="button" value="sass" data-bs-toggle="tooltip" title="{{ entry_sass }}" class="btn btn-outline-warning w-100 text-truncate button-developer"><i class="fa-solid fa-rotate"></i> {{ entry_sass }}</button></div>
          <div class="col"><button type="button" value="image" data-bs-toggle="tooltip" title="{{ entry_imagecache }}" class="btn btn-outline-secondary w-100 text-truncate button-developer"><i class="fa-regular fa-image"></i> {{ text_cache_image }}</button></div>
          <div class="col-12"><button type="button" value="all" data-bs-toggle="tooltip" title="{{ entry_allcache }}" class="btn btn-outline-danger w-100 text-truncate button-developer"><i class="fa-solid fa-broom"></i> {{ text_cache_all }}</button></div>
        </div>
        <div class="form-check form-switch mb-4">
          <input type="hidden" name="developer_sass" value="0"/>
          <input type="checkbox" name="developer_sass" value="1" id="input-domovyi-sass" class="form-check-input"{% if developer_sass %} checked{% endif %}/>
          <label for="input-domovyi-sass" class="form-check-label">{{ text_sass }}</label>
        </div>
        <h6 class="text-uppercase text-muted small">{{ text_folders }}</h6>
        {% for folder in folders %}
          <div class="mb-3" data-oc-folder="{{ folder.key }}">
            <div class="d-flex align-items-center justify-content-between">
              <span class="text-truncate">{{ folder.name }}</span>
              <span class="text-nowrap ms-2">
                <span class="badge {% if folder.warning %}text-bg-danger{% else %}text-bg-secondary{% endif %} me-1{% if not folder.size %} d-none{% endif %}">{{ folder.size }}</span>
                <button type="button" value="{{ folder.key }}" data-bs-toggle="tooltip" title="{{ text_calculate }}" class="btn btn-outline-success btn-sm button-calc"><i class="fa-solid fa-gauge"></i></button>
                <button type="button" value="{{ folder.key }}" data-bs-toggle="tooltip" title="{{ text_clear }}" class="btn btn-outline-warning btn-sm button-clear"><i class="fa-solid fa-eraser"></i></button>
              </span>
            </div>
            <div class="progress mt-1" style="height: 4px;">
              <div class="progress-bar{% if folder.warning %} bg-danger{% endif %}" style="width: {{ folder.percent }}%;"></div>
            </div>
            <div class="small text-muted mt-1 domovyi-folder-text">{{ folder.files }}{% if folder.date %} · {{ folder.date }}{% endif %}{% if folder.limit %} · {{ text_limit|format(folder.limit.size ~ ' ' ~ folder.limit.unit) }}{% endif %}</div>
          </div>
        {% endfor %}
      </div>
      <div class="col-lg-6">
        <div class="accordion accordion-flush border rounded" id="domovyi-accordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button type="button" data-bs-toggle="collapse" data-bs-target="#domovyi-extensions" class="accordion-button collapsed">
                <span class="flex-grow-1">{{ text_extensions }}</span>
                {% set missing = extensions|filter(e => not e.status)|length %}
                <span class="badge {% if missing %}text-bg-danger{% else %}text-bg-success{% endif %} me-2">{% if missing %}{{ text_missing|format(missing) }}{% else %}{{ text_all_good }}{% endif %}</span>
              </button>
            </h2>
            <div id="domovyi-extensions" class="accordion-collapse collapse" data-bs-parent="#domovyi-accordion">
              <div class="accordion-body">
                {% for extension in extensions %}
                  <span class="badge {% if extension.status %}text-bg-success{% else %}text-bg-danger{% endif %} me-1 mb-1">
                    <i class="fa-solid {% if extension.status %}fa-check{% else %}fa-xmark{% endif %}"></i> {{ extension.name }}
                  </span>
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button type="button" data-bs-toggle="collapse" data-bs-target="#domovyi-limits" class="accordion-button collapsed">
                <span class="flex-grow-1">{{ text_limits }}</span>
                {% set below = limits|filter(l => not l.status)|length %}
                <span class="badge {% if below %}text-bg-warning{% else %}text-bg-success{% endif %} me-2">{% if below %}{{ text_below|format(below) }}{% else %}{{ text_all_good }}{% endif %}</span>
              </button>
            </h2>
            <div id="domovyi-limits" class="accordion-collapse collapse" data-bs-parent="#domovyi-accordion">
              <div class="accordion-body p-0">
                <table class="table table-sm mb-0">
                  <tbody>
                    {% for limit in limits %}
                      <tr>
                        <td class="text-truncate"><code>{{ limit.name }}</code></td>
                        <td class="text-end text-nowrap">
                          <span class="{% if not limit.status %}text-danger fw-semibold{% endif %}">{{ limit.value }}</span>
                          {% if not limit.status %}<span class="text-muted small">{{ text_recommended|format(limit.recommended) }}</span>{% endif %}
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button type="button" data-bs-toggle="collapse" data-bs-target="#domovyi-permissions" class="accordion-button collapsed">
                <span class="flex-grow-1">{{ text_permissions }}</span>
                {% set readonly = permissions|filter(p => not p.status)|length %}
                <span class="badge {% if readonly %}text-bg-danger{% else %}text-bg-success{% endif %} me-2">{% if readonly %}{{ text_readonly|format(readonly) }}{% else %}{{ text_all_good }}{% endif %}</span>
              </button>
            </h2>
            <div id="domovyi-permissions" class="accordion-collapse collapse" data-bs-parent="#domovyi-accordion">
              <div class="accordion-body">
                {% for permission in permissions %}
                  <div class="d-flex justify-content-between border-bottom py-1">
                    <code class="text-truncate">{{ permission.name }}</code>
                    <i class="fa-solid {% if permission.status %}fa-check text-success{% else %}fa-xmark text-danger{% endif %} ms-2"></i>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button type="button" data-bs-toggle="collapse" data-bs-target="#domovyi-database" class="accordion-button collapsed">
                <span class="flex-grow-1">{{ text_database }}</span>
                <span class="badge text-bg-secondary me-2">{{ database.total }}</span>
              </button>
            </h2>
            <div id="domovyi-database" class="accordion-collapse collapse" data-bs-parent="#domovyi-accordion">
              <div class="accordion-body p-0">
                <table class="table table-sm mb-0">
                  <tbody>
                    {% for table in database.tables %}
                      <tr>
                        <td class="text-truncate"><code>{{ table.name }}</code>
                          <div class="text-muted small">{{ text_rows|format(table.rows) }}</div>
                        </td>
                        <td class="text-end text-nowrap align-middle">{{ table.size }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button type="button" data-bs-toggle="collapse" data-bs-target="#domovyi-errors" class="accordion-button collapsed">
                <span class="flex-grow-1">{{ text_errors }}</span>
                <span class="badge {% if errors.total %}text-bg-danger{% else %}text-bg-success{% endif %} me-2"{% if errors.trimmed %} data-bs-toggle="tooltip" title="{{ text_errors_trimmed }}"{% endif %}>{% if errors.total %}{{ errors.total }}{% if errors.trimmed %}+{% endif %}{% else %}{{ text_all_good }}{% endif %}</span>
              </button>
            </h2>
            <div id="domovyi-errors" class="accordion-collapse collapse" data-bs-parent="#domovyi-accordion">
              <div class="accordion-body">
                {% if errors.lines %}
                  <pre class="small mb-2 p-2 bg-body-secondary rounded" style="max-height: 200px; overflow: auto;">{% for line in errors.lines %}{{ line }}
{% endfor %}</pre>
                  <div class="d-flex gap-2">
                    <a href="{{ log }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-up-right-from-square"></i> {{ text_log }}</a>
                    <button type="button" id="button-error-log" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-eraser"></i> {{ button_clear }}</button>
                  </div>
                {% else %}
                  <span class="text-muted">{{ text_errors_empty }}</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button type="button" data-bs-toggle="collapse" data-bs-target="#domovyi-functions" class="accordion-button collapsed">
                <span class="flex-grow-1">{{ text_functions }}</span>
                <span class="badge {% if danger_funtions %}text-bg-danger{% else %}text-bg-success{% endif %} me-2">{% if danger_funtions %}{{ text_warning }}{% else %}{{ text_all_good }}{% endif %}</span>
              </button>
            </h2>
            <div id="domovyi-functions" class="accordion-collapse collapse" data-bs-parent="#domovyi-accordion">
              <div class="accordion-body">
                <div class="mb-2">
                  {% if danger_funtions %}
                    <div class="text-danger">{{ text_danger_info }}</div>
                    <code>{{ danger_funtions }}</code>
                  {% else %}
                    <span class="text-muted">{{ text_danger_info_normal }}</span>
                  {% endif %}
                </div>
                <div>
                  {% if warning_funtions %}
                    <div class="text-warning-emphasis">{{ text_warning_info }}</div>
                    <code>{{ warning_funtions }}</code>
                  {% else %}
                    <span class="text-muted">{{ text_warning_info_normal }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
function domovyi_alert(json) {
    $('#domovyi-alert').html('');

    if (json['error']) {
        $('#domovyi-alert').html('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
    }

    if (json['success']) {
        $('#domovyi-alert').html('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
    }
}

$('#domovyi .domovyi-copy').on('click', function() {
    var element = this;

    navigator.clipboard.writeText($($(element).attr('data-oc-copy')).text()).then(function() {
        $(element).attr('data-bs-original-title', '{{ text_copied }}').tooltip('show');

        setTimeout(function() {
            $(element).tooltip('hide').attr('data-bs-original-title', '{{ text_copy }}');
        }, 1000);
    });
});

$('#button-phpinfo').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=extension/opencart/dashboard/domovyi.phpinfo&user_token={{ user_token }}',
        dataType: 'html',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(html) {
            $('#modal-phpinfo').remove();

            $('body').prepend('<div id="modal-phpinfo" class="modal">' + html + '</div>');

            new bootstrap.Modal('#modal-phpinfo').show();
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

$('#domovyi .button-developer').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=common/developer.' + $(element).val() + '&user_token={{ user_token }}',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            domovyi_alert(json);
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

$('#input-domovyi-sass').on('change', function() {
    $.ajax({
        url: 'index.php?route=common/developer.edit&user_token={{ user_token }}',
        type: 'post',
        data: $('#domovyi input[name=\'developer_sass\']:checked'),
        dataType: 'json',
        beforeSend: function() {
            $('#input-domovyi-sass').prop('disabled', true);
        },
        complete: function() {
            $('#input-domovyi-sass').prop('disabled', false);
        },
        success: function(json) {
            domovyi_alert(json);
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

$('#button-ocmod').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=marketplace/modification.refresh&user_token={{ user_token }}',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (!json['error']) {
                json['success'] = '{{ text_ocmod_cache_success }}';
            }

            domovyi_alert(json);
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

$('#button-error-log').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=tool/log.clear&user_token={{ user_token }}&filename=error.log',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            domovyi_alert(json);
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

function domovyi_calc(element) {
    $.ajax({
        url: 'index.php?route=extension/opencart/dashboard/domovyi.calc&dir=' + encodeURIComponent($(element).val()) + '&user_token={{ user_token }}',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error']) {
                domovyi_alert(json);
            }

            if (json['text']) {
                var folder = $('#domovyi [data-oc-folder=\'' + $(element).val() + '\']');

                folder.find('.badge').removeClass('d-none').text(json['size'])
                    .toggleClass('text-bg-danger', json['warning'] != '')
                    .toggleClass('text-bg-secondary', json['warning'] == '');
                folder.find('.progress-bar').css('width', json['percent'] + '%').toggleClass('bg-danger', json['warning'] != '');
                folder.find('.domovyi-folder-text').text(json['text']);
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
}

$('#domovyi .button-calc').on('click', function() {
    domovyi_calc(this);
});

$('#domovyi .button-clear').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=extension/opencart/dashboard/domovyi.clear&dir=' + encodeURIComponent($(element).val()) + '&user_token={{ user_token }}',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            domovyi_alert(json);

            if (json['success']) {
                domovyi_calc($('#domovyi .button-calc[value=\'' + $(element).val() + '\']'));
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
