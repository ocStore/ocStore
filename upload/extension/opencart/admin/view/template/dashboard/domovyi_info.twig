<div id="domovyi-launcher">
  <button type="button" id="button-domovyi-open" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ text_open }}" class="btn shadow">
<svg viewBox="0 0 64 64" width="22" height="22" xmlns="http://www.w3.org/2000/svg" class="align-text-bottom me-1" role="img" aria-hidden="true">
  <defs>
    <mask id="dm-mlauncher" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="#000"/>
      <path d="M32 3.5 55 12v19c0 14.8-9.6 24.3-23 29.5C18.6 55.3 9 45.8 9 31V12z" fill="#fff"/>
      <path d="M32 18.5 46.5 31.5h-4.2V45H21.7V31.5h-4.2z" fill="#000"/>
      <rect x="28.8" y="35.5" width="6.4" height="9.5" rx="1.4" fill="#fff"/>
    </mask>
  </defs>
  <rect width="64" height="64" fill="currentColor" mask="url(#dm-mlauncher)"/>
</svg>
    {{ heading_title }}
    {% if issues.total %}
      <span class="badge text-bg-danger ms-1">{{ issues.total }}</span>
    {% else %}
      <span class="badge text-bg-success ms-1"><i class="fa-solid fa-check"></i></span>
    {% endif %}
  </button>
</div>
<div id="offcanvas-domovyi" class="offcanvas offcanvas-end" style="width: 780px; max-width: 100%;" tabindex="-1">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title text-truncate d-flex align-items-center gap-2"><svg viewBox="0 0 64 64" width="26" height="26" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
  <defs>
    <mask id="dm-mpanel" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="#000"/>
      <path d="M32 3.5 55 12v19c0 14.8-9.6 24.3-23 29.5C18.6 55.3 9 45.8 9 31V12z" fill="#fff"/>
      <path d="M32 18.5 46.5 31.5h-4.2V45H21.7V31.5h-4.2z" fill="#000"/>
      <rect x="28.8" y="35.5" width="6.4" height="9.5" rx="1.4" fill="#fff"/>
    </mask>
  </defs>
  <rect width="64" height="64" fill="currentColor" mask="url(#dm-mpanel)"/>
</svg> {{ heading_title }}</h5>
    <div class="ms-auto d-flex align-items-center gap-2">
      <button type="button" id="button-about" data-bs-toggle="tooltip" title="{{ text_about }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-circle-info"></i></button>
      <a href="{{ setting }}" data-bs-toggle="tooltip" title="{{ text_setting }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-cog"></i></a>
      <button type="button" class="btn-close ms-1" data-bs-dismiss="offcanvas"></button>
    </div>
  </div>
  <div class="offcanvas-body" id="offcanvas-domovyi-body">
    <div class="text-center text-muted py-5"><i class="fa-solid fa-circle-notch fa-spin fa-2x"></i></div>
  </div>
</div>
<div id="modal-domovyi-about" class="modal fade">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2"><svg viewBox="0 0 64 64" width="26" height="26" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
  <defs>
    <mask id="dm-mmodaltitle" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="#000"/>
      <path d="M32 3.5 55 12v19c0 14.8-9.6 24.3-23 29.5C18.6 55.3 9 45.8 9 31V12z" fill="#fff"/>
      <path d="M32 18.5 46.5 31.5h-4.2V45H21.7V31.5h-4.2z" fill="#000"/>
      <rect x="28.8" y="35.5" width="6.4" height="9.5" rx="1.4" fill="#fff"/>
    </mask>
  </defs>
  <rect width="64" height="64" fill="currentColor" mask="url(#dm-mmodaltitle)"/>
</svg> {{ heading_title }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-center text-body mb-3"><svg viewBox="0 0 64 64" width="104" height="104" xmlns="http://www.w3.org/2000/svg" class="text-success" role="img" aria-hidden="true">
  <defs>
    <mask id="dm-mmodal" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="#000"/>
      <path d="M32 3.5 55 12v19c0 14.8-9.6 24.3-23 29.5C18.6 55.3 9 45.8 9 31V12z" fill="#fff"/>
      <path d="M32 18.5 46.5 31.5h-4.2V45H21.7V31.5h-4.2z" fill="#000"/>
      <rect x="28.8" y="35.5" width="6.4" height="9.5" rx="1.4" fill="#fff"/>
    </mask>
  </defs>
  <rect width="64" height="64" fill="currentColor" mask="url(#dm-mmodal)"/>
</svg></div>
        <p>{{ text_about_intro }}</p>
        <p class="fw-semibold">{{ text_about_community }}</p>
        <blockquote class="border-start border-3 ps-3 text-body-secondary fst-italic">{{ text_about_inspire }}</blockquote>
        <div class="d-grid gap-2">
          <a href="https://opencartforum.com/profile/3769-dinox/" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fa-solid fa-user"></i> {{ text_about_author }}</a>
          <a href="https://opencartforum.com/files/file/8732-domoviy-vidzhet-dlya-monitoringu-stanu-magazinu" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{ text_about_updates }}</a>
          <a href="https://opencartforum.com/files/developer/3769-dinox/" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fa-solid fa-puzzle-piece"></i> {{ text_about_files }}</a>
        </div>
      </div>
      <div class="modal-footer justify-content-center"><small class="text-muted">{{ text_copyright }}</small></div>
    </div>
  </div>
</div>
<style>
#domovyi-launcher {
	position: fixed;
	right: 24px;
	bottom: 0;
	z-index: 1030;
}

#domovyi-launcher .btn {
	border: 0;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
	padding: 0.5rem 1rem;
	color: #fff;
	background: linear-gradient(180deg, #2fb862, #17994b);
}

#domovyi-launcher .btn:hover,
#domovyi-launcher .btn:focus {
	color: #fff;
	background: linear-gradient(180deg, #37cc6f, #1caa55);
}
</style>
<script type="text/javascript"><!--
$('#domovyi-launcher, #offcanvas-domovyi, #modal-domovyi-about').appendTo('body');

$('#button-about').on('click', function() {
    new bootstrap.Modal('#modal-domovyi-about').show();
});

$('#offcanvas-domovyi').on('show.bs.offcanvas', function() {
    if (!$(this).attr('data-oc-loaded')) {
        $(this).attr('data-oc-loaded', 1);

        $('#offcanvas-domovyi-body').load('index.php?route=extension/opencart/dashboard/domovyi.panel&user_token={{ user_token }}');
    }
});

$('#button-domovyi-open').on('click', function() {
    bootstrap.Offcanvas.getOrCreateInstance('#offcanvas-domovyi').show();
});
//--></script>
